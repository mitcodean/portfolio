# Add these entries to .env.local. Do not overwrite existing contact configuration.
# Server-only; never prefix any of these variables with NEXT_PUBLIC_ or VITE_.
OPENAI_API_KEY=
# Only gpt-4.1-nano or gpt-5-nano. This is the initial selection in the UI.
OPENAI_MODEL=gpt-5-nano
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep stable across restarts and identical across server instances.
INQUIRY_RATE_LIMIT_SECRET=
# Five attempts per visitor AND network in a rolling 24-hour window are fixed in code.
# Additional shared cost cap for ALL visitors combined (5..500).
INQUIRY_GLOBAL_DAILY_LIMIT=25
# Safe local default. Public access requires Redis plus a trusted edge IP header.
INQUIRY_LOCAL_ONLY=true
# Optional temporary bypass, effective ONLY in next dev with local-only access.
# Production builds always enforce the limits. Set false to restore local limits.
INQUIRY_UNLIMITED_LOCAL_TESTS=false
INQUIRY_LIMITER=file

# Optional: required only for a later, separately reviewed public deployment.
# INQUIRY_LIMITER=redis
# INQUIRY_LOCAL_ONLY=false
# Edge must overwrite this header; direct access to the origin server must be blocked.
# Supported: cf-connecting-ip or x-real-ip. Never trust a caller-supplied header.
# INQUIRY_TRUSTED_IP_HEADER=cf-connecting-ip
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
